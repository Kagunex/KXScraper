---
import { BookOpen, CodeXml, GitBranch, LifeBuoy, Scale, Shield, ShieldAlert } from '@lucide/astro';
---

<footer class="site-footer">
  <div class="footer-brand">
    <span class="brand-mark"><CodeXml size={17} stroke-width={2.5} aria-hidden="true" /></span>
    <span class="footer-brand-copy"><strong>KXScraper</strong>OPEN SOURCE · MIT LICENSE</span>
  </div>
  <nav class="footer-links" aria-label="Footer navigation">
    <a href="/docs/"><BookOpen size={13} aria-hidden="true" /> Documentation</a>
    <a href="/contact"><LifeBuoy size={13} aria-hidden="true" /> Contact</a>
    <a href="/terms"><Scale size={13} aria-hidden="true" /> Terms</a>
    <a href="/privacy"><Shield size={13} aria-hidden="true" /> Privacy</a>
    <a href="/dmca"><ShieldAlert size={13} aria-hidden="true" /> DMCA</a>
    <a href="https://github.com/hexxt-git/anime-sdk" target="_blank" rel="noopener noreferrer"><GitBranch size={13} aria-hidden="true" /> GitHub</a>
  </nav>
  <div class="footer-bottom">
    <span>Search. Resolve. Integrate.</span>
    <span>One interface across upstream providers.</span>
  </div>
</footer>
