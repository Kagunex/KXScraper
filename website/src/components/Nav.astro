---
import { BookOpen, CodeXml, GitBranch, Network, Radio, Server, ShieldCheck } from '@lucide/astro';
---

<header class="site-nav">
  <nav class="nav-inner" aria-label="Main navigation">
    <a href="/" class="brand-lockup" aria-label="KXScraper home">
      <span class="brand-mark"><CodeXml size={19} stroke-width={2.5} aria-hidden="true" /></span>
      <span class="brand-name">KX<span>Scraper</span></span>
    </a>
    <div class="nav-links">
      <a href="/docs/"><BookOpen size={14} aria-hidden="true" /> Docs</a>
      <a href="/#capabilities"><Network size={14} aria-hidden="true" /> Capabilities</a>
      <a href="/#server"><Server size={14} aria-hidden="true" /> HTTP API</a>
      <a href="/#providers"><Radio size={14} aria-hidden="true" /> Providers</a>
      <a href="/faq"><ShieldCheck size={14} aria-hidden="true" /> FAQ</a>
    </div>
    <div class="nav-utilities">
      <a class="nav-github" href="https://github.com/hexxt-git/anime-sdk" target="_blank" rel="noopener noreferrer" aria-label="KXScraper on GitHub"><GitBranch size={17} aria-hidden="true" /></a>
      <a href="/docs/" class="action nav-cta">Start building <CodeXml size={14} aria-hidden="true" /></a>
    </div>
  </nav>
  <nav class="mobile-nav" aria-label="Mobile navigation">
    <a href="/docs/"><BookOpen size={13} aria-hidden="true" /> Docs</a>
    <a href="/#capabilities"><Network size={13} aria-hidden="true" /> Capabilities</a>
    <a href="/#server"><Server size={13} aria-hidden="true" /> HTTP API</a>
    <a href="/#providers"><Radio size={13} aria-hidden="true" /> Providers</a>
    <a href="/faq"><ShieldCheck size={13} aria-hidden="true" /> FAQ</a>
  </nav>
</header>
