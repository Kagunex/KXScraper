---
import { ArrowDown, ArrowRight, GitBranch, Radio, Terminal } from '@lucide/astro';
import HeroBackground from './islands/HeroBackground';
---

<section class="hero" aria-labelledby="hero-title">
  <HeroBackground client:visible />
  <div class="hero-copy">
    <div class="eyebrow"><Radio size={14} stroke-width={2} aria-hidden="true" /> Open-source media tooling</div>
    <h1 id="hero-title">One interface.<br /><span class="accent-line">Every source.</span></h1>
    <p>
      KXScraper searches anime and manga catalogs, resolves playable streams and subtitle tracks, and exposes the same workflow through a TypeScript SDK or HTTP API.
    </p>
    <div class="hero-actions">
      <a href="/docs/" class="action">Read the documentation <ArrowRight size={16} stroke-width={2.2} aria-hidden="true" /></a>
      <a href="https://github.com/hexxt-git/anime-sdk" target="_blank" rel="noopener noreferrer" class="action action-secondary"><GitBranch size={16} stroke-width={2} aria-hidden="true" /> View repository</a>
    </div>
    <div class="hero-meta" aria-label="Project details">
      <span class="badge badge-ok"><span class="status-dot" aria-hidden="true"></span> MIT licensed</span>
      <span class="badge"><Terminal size={12} stroke-width={2} aria-hidden="true" /> Node.js / Bun</span>
      <a class="badge badge-muted" href="#capabilities"><ArrowDown size={12} aria-hidden="true" /> Explore capabilities</a>
    </div>
  </div>
  <div class="hero-index" aria-hidden="true"><b>KX / 001</b> &nbsp;·&nbsp; SEARCH → RESOLVE → DELIVER</div>
</section>
