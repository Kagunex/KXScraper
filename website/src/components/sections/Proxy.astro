---
import { ArrowRight, Braces, Captions, Globe, ShieldCheck } from '@lucide/astro';

const proxyEnableCode = `<code><span class="fn">startServer</span><span class="pun">({</span>
  providers<span class="pun">:</span> <span class="pun">[</span><span class="kw">new</span> <span class="fn">GogoanimeProvider</span><span class="pun">(</span><span class="kw">new</span> <span class="fn">HttpClient</span><span class="pun">())],</span>
  port<span class="pun">:</span> <span class="num">3000</span><span class="pun">,</span>
  proxy<span class="pun">:</span> <span class="kw">true</span><span class="pun">,</span>  <span class="cm">// enable stream and subtitle proxying</span>
<span class="pun">});</span></code>`;

const proxyRewriteCode = `<code><span class="cm">// upstream stream response</span>
<span class="pun">{</span>
  sourceUrl<span class="pun">:</span> <span class="str">"https://cdn.example.com/ep1.m3u8"</span><span class="pun">,</span>
  headers<span class="pun">:</span> <span class="pun">{</span> <span class="prop">Referer</span><span class="pun">:</span> <span class="str">"https://provider.com/watch/..."</span> <span class="pun">}</span>
<span class="pun">}</span>

<span class="cm">// with proxy enabled</span>
<span class="pun">{</span>
  sourceUrl<span class="pun">:</span> <span class="str">"http://localhost:3000/proxy?url=...&amp;h=..."</span>
<span class="pun">}</span></code>`;

const proxyPlayerCode = `<code><span class="cm">// use the returned sourceUrl with hls.js</span>
<span class="kw">const</span> hls <span class="pun">=</span> <span class="kw">new</span> <span class="fn">Hls</span><span class="pun">();</span>
hls<span class="pun">.</span><span class="fn">loadSource</span><span class="pun">(</span>sourceUrl<span class="pun">);</span>
hls<span class="pun">.</span><span class="fn">attachMedia</span><span class="pun">(</span>videoEl<span class="pun">);</span>

<span class="cm">// segments, keys, and sub-playlists are rewritten too</span></code>`;
---

<section id="proxy" class="reveal" aria-labelledby="proxy-title">
  <div class="section-head section-head-split">
    <div>
      <div class="section-kicker">04 / Stream transport</div>
      <h2 class="section-heading" id="proxy-title">Carry the provider headers through to playback.</h2>
      <a href="/docs/proxy/" class="text-link">How the proxy works <ArrowRight size={15} aria-hidden="true" /></a>
    </div>
    <div>
      <p class="section-intro">When a CDN expects a Referer or other request headers, the optional server proxy forwards them for stream and subtitle requests. Clients can use the rewritten URL directly.</p>
      <div class="proxy-points"><span><ShieldCheck size={14} aria-hidden="true" /> Header forwarding</span><span><Braces size={14} aria-hidden="true" /> HLS URI rewriting</span><span><Captions size={14} aria-hidden="true" /> Subtitle tracks</span></div>
    </div>
  </div>
  <div class="proxy-flow" aria-label="Proxy setup and usage examples">
    <article class="proxy-step">
      <div class="proxy-step-head"><span class="step-number">01</span><span class="code-window-title"><Globe size={14} aria-hidden="true" /> Enable the server option</span></div>
      <pre set:html={proxyEnableCode} />
    </article>
    <article class="proxy-step proxy-step-wide">
      <div class="proxy-step-head"><span class="step-number">02</span><span class="code-window-title"><ShieldCheck size={14} aria-hidden="true" /> Receive a browser-ready URL</span></div>
      <pre set:html={proxyRewriteCode} />
      <p class="server-note">The proxy also rewrites HLS segment, key, and sub-playlist URLs while preserving the required header chain.</p>
    </article>
    <article class="proxy-step">
      <div class="proxy-step-head"><span class="step-number">03</span><span class="code-window-title"><Captions size={14} aria-hidden="true" /> Attach it to a player</span></div>
      <pre set:html={proxyPlayerCode} />
    </article>
  </div>
</section>
