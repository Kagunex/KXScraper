---
import { ArrowRight, Clipboard, CodeXml, Play, SquareTerminal } from '@lucide/astro';

const install = 'npm install anime-sdk';
const example = `import { HttpClient, MegaPlayProvider } from 'anime-sdk';

const provider = new MegaPlayProvider(new HttpClient());
const shows = await provider.search('Frieren');
const episodes = await provider.fetchContentUnits(shows[0].id);
const result = await provider.resolveStream(episodes[0].id);

if (result.type === 'video') {
  console.log(result.streams[0].sourceUrl);
}`;

const megaplayCode = `<code><span class="kw">import</span> <span class="pun">{</span> <span class="typ">HttpClient</span><span class="pun">,</span> <span class="typ">MegaPlayProvider</span> <span class="pun">}</span> <span class="kw">from</span> <span class="str">'anime-sdk'</span><span class="pun">;</span>

<span class="kw">const</span> provider <span class="pun">=</span> <span class="kw">new</span> <span class="fn">MegaPlayProvider</span><span class="pun">(</span><span class="kw">new</span> <span class="fn">HttpClient</span><span class="pun">());</span>
<span class="kw">const</span> shows <span class="pun">=</span> <span class="kw">await</span> provider<span class="pun">.</span><span class="fn">search</span><span class="pun">(</span><span class="str">'Frieren'</span><span class="pun">);</span>
<span class="kw">const</span> episodes <span class="pun">=</span> <span class="kw">await</span> provider<span class="pun">.</span><span class="fn">fetchContentUnits</span><span class="pun">(</span>shows<span class="pun">[</span><span class="num">0</span><span class="pun">].</span>id<span class="pun">);</span>
<span class="kw">const</span> result <span class="pun">=</span> <span class="kw">await</span> provider<span class="pun">.</span><span class="fn">resolveStream</span><span class="pun">(</span>episodes<span class="pun">[</span><span class="num">0</span><span class="pun">].</span>id<span class="pun">);</span>

<span class="kw">if</span> <span class="pun">(</span>result<span class="pun">.</span>type <span class="pun">===</span> <span class="str">'video'</span><span class="pun">)</span> <span class="fn">console</span><span class="pun">.</span><span class="fn">log</span><span class="pun">(</span>result<span class="pun">.</span>streams<span class="pun">[</span><span class="num">0</span><span class="pun">].</span>sourceUrl<span class="pun">);</span></code>`;
---

<section id="demo" class="reveal" aria-labelledby="demo-title">
  <div class="section-head section-head-split">
    <div>
      <div class="section-kicker">06 / In practice</div>
      <h2 class="section-heading" id="demo-title">Search to stream in a few calls.</h2>
    </div>
    <div>
      <p class="section-intro">Provider adapters share the same workflow: search, fetch episodes or chapters, then resolve a stream or page set.</p>
      <div class="demo-sequence"><span>search</span><ArrowRight size={13} aria-hidden="true" /><span>content</span><ArrowRight size={13} aria-hidden="true" /><span>resolve</span></div>
    </div>
  </div>
  <div class="demo-layout">
    <div class="demo-code-column">
      <div class="code-window">
        <div class="code-window-head">
          <span class="code-window-title"><CodeXml size={14} aria-hidden="true" /> TypeScript / provider.ts</span>
          <button class="copy-button" type="button" data-copy-target="demo-code" aria-label="Copy TypeScript example"><Clipboard size={13} aria-hidden="true" /><span aria-live="polite">Copy code</span></button>
        </div>
        <div id="demo-code" class="demo-code" data-copy-text={example} set:html={megaplayCode} />
      </div>
      <div class="install-line">
        <span class="install-label"><SquareTerminal size={14} aria-hidden="true" /> Install</span>
        <code>{install}</code>
        <button class="copy-button" type="button" data-copy-target="install-code" aria-label="Copy install command"><Clipboard size={13} aria-hidden="true" /><span aria-live="polite">Copy</span></button>
        <span id="install-code" data-copy-text={install} class="sr-only">{install}</span>
      </div>
      <p class="demo-footnote">The npm package name stays <code>anime-sdk</code>; KXScraper is the product identity.</p>
    </div>
    <div class="demo-media">
      <div class="media-label"><Play size={13} aria-hidden="true" /> Interactive dashboard preview</div>
      <video controls playsinline preload="none" aria-label="KXScraper example dashboard preview" src="/anime-sdk-test.mp4"></video>
      <a href="https://github.com/hexxt-git/anime-sdk/tree/master/examples/website" target="_blank" rel="noopener noreferrer" class="media-link">Open the example dashboard <ArrowRight size={14} aria-hidden="true" /></a>
    </div>
  </div>
  <script>
    document.querySelectorAll<HTMLButtonElement>('[data-copy-target]').forEach((button) => {
      button.addEventListener('click', async () => {
        const targetId = button.dataset.copyTarget;
        const target = targetId ? document.getElementById(targetId) : null;
        const text = target?.dataset.copyText ?? target?.textContent ?? '';
        const label = button.querySelector('span');
        if (!text) return;
        try {
          if (navigator.clipboard?.writeText) {
            await navigator.clipboard.writeText(text.trim());
          } else {
            throw new Error('Clipboard API unavailable');
          }
          if (label) label.textContent = 'Copied';
          button.classList.add('is-copied');
          window.setTimeout(() => {
            if (label) label.textContent = button.dataset.copyTarget === 'install-code' ? 'Copy' : 'Copy code';
            button.classList.remove('is-copied');
          }, 1600);
        } catch {
          if (label) label.textContent = 'Copy unavailable';
        }
      });
    });
  </script>
</section>
