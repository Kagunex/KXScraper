---
import { Monitor, PanelsTopLeft, Server, Smartphone, Terminal } from '@lucide/astro';

const environments = [
  { label: 'Mobile clients', desc: 'React Native, Expo, Flutter, Kotlin, and Swift apps call the HTTP server.', Icon: Smartphone },
  { label: 'Web applications', desc: 'Use the server from browser clients, SSR apps, and frontend frameworks.', Icon: PanelsTopLeft },
  { label: 'Desktop tools', desc: 'Connect Electron, Tauri, and native desktop clients to a single API.', Icon: Monitor },
  { label: 'CLI workflows', desc: 'Build scripts, interactive terminals, and local download workflows with Node or Bun.', Icon: Terminal },
  { label: 'Services and bots', desc: 'Integrate search, episode lookup, and stream resolution into your own services.', Icon: Server },
];
---

<section id="capabilities" class="reveal" aria-labelledby="capabilities-title">
  <div class="section-head">
    <div class="section-kicker">01 / One interface</div>
    <h2 class="section-heading" id="capabilities-title">Use the same media pipeline wherever your app runs.</h2>
    <p class="section-intro">Run providers directly in Node.js or Bun, or expose them over HTTP for clients that cannot run the SDK.</p>
  </div>
  <div class="environment-list">
    {environments.map(({ label, desc, Icon }, index) => (
      <div class="environment-row">
        <span class="environment-index">0{index + 1}</span>
        <span class="glyph"><Icon aria-hidden="true" /></span>
        <h3>{label}</h3>
        <p>{desc}</p>
      </div>
    ))}
  </div>
</section>
