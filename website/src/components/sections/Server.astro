---
import { ArrowRight, Braces, Database, LockKeyhole, Server } from '@lucide/astro';

const serverStartCode = `<code><span class="kw">import</span> <span class="pun">{</span> <span class="typ">startServer</span><span class="pun">,</span> <span class="typ">AllmangaProvider</span><span class="pun">,</span> <span class="typ">HttpClient</span> <span class="pun">}</span> <span class="kw">from</span> <span class="str">'anime-sdk'</span><span class="pun">;</span>

<span class="kw">const</span> store <span class="pun">=</span> <span class="kw">new</span> <span class="fn">Map</span><span class="pun">();</span>

<span class="fn">startServer</span><span class="pun">({</span>
  providers<span class="pun">:</span> <span class="pun">[</span><span class="kw">new</span> <span class="fn">AllmangaProvider</span><span class="pun">(</span><span class="kw">new</span> <span class="fn">HttpClient</span><span class="pun">())],</span>
  port<span class="pun">:</span> <span class="num">3000</span><span class="pun">,</span>
  proxy<span class="pun">:</span> <span class="kw">true</span><span class="pun">,</span>
  cache<span class="pun">:</span> <span class="pun">{</span> get<span class="pun">:</span> <span class="pun">(</span>k<span class="pun">)</span> <span class="pun">=&gt;</span> store<span class="pun">.</span><span class="fn">get</span><span class="pun">(</span>k<span class="pun">),</span> set<span class="pun">:</span> <span class="pun">(</span>k<span class="pun">,</span> v<span class="pun">)</span> <span class="pun">=&gt;</span> store<span class="pun">.</span><span class="fn">set</span><span class="pun">(</span>k<span class="pun">,</span> v<span class="pun">)</span> <span class="pun">},</span>
<span class="pun">});</span>

<span class="cm">// → http://localhost:3000</span></code>`;

const serverCurlCode = `<code><span class="cm"># search shows or manga</span>
curl <span class="str">'localhost:3000/search?q=Frieren&amp;provider=mangadex'</span>

<span class="cm"># content: episodes or chapters</span>
curl <span class="str">'localhost:3000/content?mediaId=...&amp;provider=mangadex'</span>

<span class="cm"># resolve: streams or image pages</span>
curl <span class="str">'localhost:3000/stream?unitId=...&amp;provider=mangadex'</span></code>`;

const serverAuthCode = `<code><span class="fn">startServer</span><span class="pun">({</span>
  providers<span class="pun">:</span> <span class="pun">[</span><span class="kw">new</span> <span class="fn">AllmangaProvider</span><span class="pun">(</span><span class="kw">new</span> <span class="fn">HttpClient</span><span class="pun">())],</span>
  port<span class="pun">:</span> <span class="num">3000</span><span class="pun">,</span>
  auth<span class="pun">:</span> <span class="pun">{</span> token<span class="pun">:</span> process<span class="pun">.</span>env<span class="pun">.</span><span class="prop">API_TOKEN</span> <span class="pun">},</span>
<span class="pun">});</span>

<span class="cm">// Clients send:</span>
<span class="cm">// Authorization: Bearer &lt;token&gt;</span></code>`;
---

<section id="server" class="reveal" aria-labelledby="server-title">
  <div class="section-head section-head-split">
    <div>
      <div class="section-kicker">03 / HTTP API</div>
      <h2 class="section-heading" id="server-title">A ready-to-run server for every client.</h2>
      <a href="/docs/http-server/" class="text-link">Read the HTTP server guide <ArrowRight size={15} aria-hidden="true" /></a>
    </div>
    <div>
      <p class="section-intro">Search, episode and chapter lookup, stream resolution, track metadata, optional stream and subtitle proxying, cache hooks, and bearer-token auth.</p>
      <div class="endpoint-list"><span><Braces size={12} aria-hidden="true" /> /search</span><span><Database size={12} aria-hidden="true" /> /content</span><span><Server size={12} aria-hidden="true" /> /stream</span><span><LockKeyhole size={12} aria-hidden="true" /> /proxy</span></div>
    </div>
  </div>
  <div class="server-examples">
    <div class="server-example">
      <div class="code-window-head"><span class="code-window-title"><Server size={13} aria-hidden="true" /> server.ts</span><span class="badge badge-ok">Boot</span></div>
      <pre set:html={serverStartCode} />
    </div>
    <div class="server-example">
      <div class="code-window-head"><span class="code-window-title"><Braces size={13} aria-hidden="true" /> curl / fetch / axios</span><span class="badge">HTTP</span></div>
      <pre set:html={serverCurlCode} />
      <p class="server-note">Any client that speaks HTTP: React Native, Swift, Kotlin, Flutter, or Python.</p>
    </div>
    <div class="server-example">
      <div class="code-window-head"><span class="code-window-title"><LockKeyhole size={13} aria-hidden="true" /> Optional bearer auth</span><span class="badge">Auth</span></div>
      <pre set:html={serverAuthCode} />
      <p class="server-note">Use authentication when clients connect beyond your local environment.</p>
    </div>
  </div>
</section>
